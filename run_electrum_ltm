#!/usr/bin/env python3
# -*- mode: python -*-
#
# Electrum-LTM - Laptop Mining Coin Wallet
# Based on Electrum Bitcoin Wallet
#

import os
import sys

# LTM 네트워크를 기본으로 설정
if not any(arg.startswith('--') and ('mainnet' in arg or 'testnet' in arg or 'regtest' in arg or 'signet' in arg or 'ltm' in arg) for arg in sys.argv):
    sys.argv.append('--ltm')

# 원본 run_electrum 임포트 및 실행
script_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, script_dir)

# run_electrum의 main 함수를 직접 임포트하여 실행
if __name__ == '__main__':
    exec(open(os.path.join(script_dir, 'run_electrum')).read())