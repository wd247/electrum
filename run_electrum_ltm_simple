def main():
    if len(sys.argv) > 1:
        if sys.argv[1] in ['--help', '-h']:
            show_help()
            return
        elif sys.argv[1] == '--gui':
            print("🚧 GUI 모드는 준비 중입니다...")
            show_ltm_info()
            return
        elif sys.argv[1] == '--cli':
            print("🚧 CLI 모드는 준비 중입니다...")
            show_ltm_info() 
            return
    
    show_help()

if __name__ == '__main__':
    main()