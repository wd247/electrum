def show_help():
    show_ltm_info()
    print("\n📖 사용법:")
    print("   ./run_electrum_ltm_simple        - LTM 네트워크 정보 표시")
    print("   ./run_electrum_ltm_simple --gui  - GUI 모드 (준비중)")
    print("   ./run_electrum_ltm_simple --cli  - CLI 모드 (준비중)")
    print("\n⚠️  현재 상태: 설정 완료, Electrum 의존성 설치 필요")
    print("\n🔧 설정된 LTM 파일들:")
