    print("🚀 Electrum-LTM (Laptop Mining Coin Wallet)")
    print("=" * 50)
    print("📋 LTM 네트워크 정보:")
    print(f"   제네시스 블록: 20a1cb14930e9cc8f0b7e6872b0630a86c135a6903aec70b6c4e63457c7948a8")
